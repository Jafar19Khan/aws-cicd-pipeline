# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is git-ignored, so your IP address is not published.

aws_region = "ap-south-1"

# Your public IP with /32 at the end. Find it by searching "what is my IP".
my_ip_cidr = "203.0.113.25/32"

# Name of an EC2 key pair that already exists in this region.
key_name = "my-key-pair"

# Optional overrides
# jenkins_instance_type = "t3.small"
# app_instance_type     = "t3.micro"
